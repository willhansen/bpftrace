NAME self_probe_components_builtin
RUN {{BPFTRACE}} -e 'self:signal:SIGUSR1 { printf("%s %s %s", probe_components.type, probe_components.target, probe_components.signal); } self:signal:SIGUSR1 { printf(" second\n"); exit(); }'
AFTER kill -s USR1 $(pidof bpftrace)
EXPECT_REGEX self signal SIGUSR1

